    object btClose: TButton
      Left = 864
      Height = 25
      Top = 8
      Width = 88
      Anchors = [akTop, akRight]
      Caption = 'Close'
      Cancel = True
      ModalResult = 11
      OnClick = btCloseClick
      TabOrder = 8
    end
  end
  object lvEntries: TVarGrid
    Left = 0
    Height = 450
    Top = 69
    Width = 960
    Align = alClient
    Columns = <
      item
        Title.Caption = 'Archive'
        Width = 140
      end
      item
        Title.Caption = 'Name'
        Width = 260
      end
      item
        Alignment = taRightJustify
        Title.Caption = 'Size'
        Width = 90
      end
      item
        Title.Caption = 'Added'
        Width = 130
      end
      item
        Title.Caption = 'Archived'
        Width = 130
      end
      item
        Title.Caption = 'Download folder'
        Width = 220
      end
      item
        Title.Caption = 'Labels'
        Width = 140
      end
      item
        Title.Caption = 'Metadata'
        Width = 150
      end
      item
        Title.Caption = 'Local data'
        Width = 100
      end>
    RowCount = 1
    FixedCols = 0
    FixedRows = 1
    Options = [goFixedVertLine, goFixedHorzLine, goColSizing, goColMoving, goRowSelect, goThumbTracking, goDblClickAutoSize, goHeaderHotTracking, goHeaderPushedLook]
    TabOrder = 1
    MultiSelect = True
    OnClick = lvEntriesClick
    OnDblClick = lvEntriesDblClick
    OnKeyDown = lvEntriesKeyDown
  end
  object SaveDialog1: TSaveDialog
    DefaultExt = 'zip'
    Filter = 'ZIP archives (*.zip)|*.zip|All files (*.*)|*.*'
    Options = [ofOverwritePrompt, ofEnableSizing]
    Left = 8
    Top = 8
  end
  object OpenDialog1: TOpenDialog
    Filter = 'ZIP archives (*.zip)|*.zip|All files (*.*)|*.*'
    Options = [ofFileMustExist, ofEnableSizing]
    Left = 40
    Top = 8
  end
end
